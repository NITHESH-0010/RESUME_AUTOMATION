# ---- 1. Gemini (resume content generation) ----
# Get from https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=
# Gemini model names change over time — if you get a 404 "model not
# found" error, check https://ai.google.dev/gemini-api/docs/models for
# the current model name and set it here.
GEMINI_MODEL=gemini-3.6-flash

# ---- 2. Google Sheets (submission logging) ----
# Path to your service-account JSON key.
# - Running locally (uvicorn): just the filename, e.g. service-account.json
# - Running via docker-compose: /app/service-account.json (already mounted there)
# (create the key in Google Cloud Console -> IAM & Admin -> Service Accounts,
#  enable the "Google Sheets API", then share your sheet with the
#  service account's client_email as an Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_NAME=Sheet1

# ---- 3. Gmail (send resume PDF to candidate) ----
# Use a Gmail App Password, NOT your normal password:
# https://myaccount.google.com/apppasswords (requires 2FA enabled)
GMAIL_ADDRESS=your-address@gmail.com
GMAIL_APP_PASSWORD=

# ---- 4. Telegram (admin notification) ----
# Message @BotFather on Telegram -> /newbot -> copy the token.
# Get your chat ID by messaging @userinfobot or @RawDataBot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
